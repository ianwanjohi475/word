# ---------------------------------------------------------------------------
# Converta environment configuration
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your Groq API key.
#
#   cp .env.example .env
#
# Get a free key at https://console.groq.com/keys
#
# SECURITY: Any EXPO_PUBLIC_* value is bundled into the client app and is
# extractable from the shipped binary. This is fine for personal / prototype
# use, but for a public release you should put a thin proxy server in front of
# Groq that holds the real key server-side, and point the app at the proxy.
# ---------------------------------------------------------------------------

# Required: your Groq API key.
EXPO_PUBLIC_GROQ_API_KEY=

# Optional: override the vision model. Groq deprecates models frequently, so
# check https://console.groq.com/docs/models and set whatever multimodal model
# is currently live. Leave blank to use the app default.
EXPO_PUBLIC_GROQ_MODEL=
