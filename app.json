{
  "expo": {
    "name": "Converta",
    "slug": "converta",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "converta",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.converta.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Converta uses the camera so you can scan documents and convert them into editable files.",
        "NSPhotoLibraryUsageDescription": "Converta needs access to your photos to import documents for conversion.",
        "NSPhotoLibraryAddUsageDescription": "Converta saves your converted files to your device so you can access them later.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.converta.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Converta needs access to your photos to import documents for conversion."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Converta uses the camera so you can scan documents and convert them into editable files."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Converta saves your converted files to your device.",
          "savePhotosPermission": "Converta saves your converted files to your device.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
